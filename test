function doGet(e) {
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheets()[0];
  const data = sheet.getDataRange().getValues();
  
  // 1. 收集 A 欄所有股票代號，組成證交所查詢字串 (上市 tse_ 與 上櫃 otc_ 同時查)
  const codes = [];
  const queryList = [];
  data.forEach(row => {
    const code = String(row[0]).replace(/^TPE:/i, '').trim();
    if (code) {
      codes.push(code);
      queryList.push(`tse_${code}.tw`, `otc_${code}.tw`);
    }
  });

  if (queryList.length === 0) {
    return ContentService.createTextOutput('{}').setMimeType(ContentService.MimeType.JSON);
  }

  // 2. 直接向台灣證交所即時報價 API 請求最新成交價
  const url = `https://mis.twse.com.tw/stock/api/getStockInfo.jsp?ex_ch=${queryList.join('|')}&json=1&delay=0`;
  const response = UrlFetchApp.fetch(url, { muteHttpExceptions: true });
  const json = JSON.parse(response.getContentText());
  
  const result = {};
  if (json && json.msgArray) {
    json.msgArray.forEach(item => {
      const code = item.c; // 股票代號
      const prevClose = parseFloat(item.y); // 昨收價
      // z 為當盤最新成交價；若剛開盤或集合競價尚未成交(顯示'-')，則取最佳買價(b)或昨收
      let price = parseFloat(item.z);
      if (isNaN(price) && item.b) {
        price = parseFloat(item.b.split('_')[0]);
      }
      if (isNaN(price)) price = prevClose;

      if (code && !isNaN(price) && price > 0) {
        result[code] = { price: price, prevClose: prevClose || price };
      }
    });
  }

  return ContentService.createTextOutput(JSON.stringify(result))
    .setMimeType(ContentService.MimeType.JSON);
}
